# Copie este archivo como .env. No lo comparta ni lo suba a Git.
# SQLSERVER_SERVER acepta SERVIDOR, SERVIDOR\INSTANCIA o servidor.dif.local,1433.
DATABASE_BACKEND=sqlserver
SQLSERVER_SERVER=SERVIDORSQL\INSTANCIA
SQLSERVER_DATABASE=CapturaApoyosDIF
SQLSERVER_AUTH=windows
SQLSERVER_USERNAME=
SQLSERVER_PASSWORD=
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_CERTIFICATE=false

# Se generan durante la instalación. No use estos valores de ejemplo.
SECRET_KEY=CAMBIAR_POR_VALOR_ALEATORIO_DE_64_CARACTERES
ADMIN_EMAIL=captura@dif.local
ADMIN_PASSWORD=CAMBIAR_POR_CONTRASENA_LARGA_Y_UNICA

# IIS se encarga del certificado y de redirigir a HTTPS.
COOKIE_SECURE=true
FORCE_HTTPS=false
MAX_UPLOAD_MB=8

# Para una prueba sin SQL Server, cambie DATABASE_BACKEND=url y habilite:
# DATABASE_URL=sqlite:///./data/captura_apoyos.sqlite3
